# Re:Place server-only authentication
# Use the Neon Auth base URL that belongs to the same environment as DATABASE_URL.
NEON_AUTH_BASE_URL=

# Generate a unique 32+ character random value per environment.
# Never reuse the production value in Preview/Development.
NEON_AUTH_COOKIE_SECRET=

# Optional NAVER API HUB Blog Search observation (server-only)
# Do not expose these values to browser code.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
